# ===== Bizzmind — локална конфигурация (файлът е извън git) =====

# ---- AI
# subscription = локално през Claude Code абонамента; api = продукция през Anthropic API
AI_BACKEND=
# console.anthropic.com → API Keys  (задължително за AI_BACKEND=api)
ANTHROPIC_API_KEY=

# ---- Gamma (презентации)
GAMMA_API_KEY=
# Публичен адрес на сървъра, за да може Gamma да тегли графики/лого (start.sh го обновява)
PUBLIC_BASE_URL=

# ---- База данни
# локален Postgres за разработка (ползва се само ако SUPABASE_DB_URL е празен)
DATABASE_URL=
# Supabase → Settings → Database → Connection string → Transaction pooler (порт 6543); замени [YOUR-PASSWORD]
SUPABASE_DB_URL=

# ---- Supabase (проект knyznqohyvikesjtjdso)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
